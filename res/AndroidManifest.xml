<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Başlık -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle Rental System"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Araba Ekle Butonu -->
        <Button
            android:id="@+id/btnAddCar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Car (Aston Martin)"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Motosiklet Ekle Butonu -->
        <Button
            android:id="@+id/btnAddMotor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Motorcycles"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Araçları Listele Butonu -->
        <Button
            android:id="@+id/btnViewVehicles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View All Vehicles"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <!-- Çıktıların Görüneceği Alan -->
        <TextView
            android:id="@+id/txtOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Output will appear here..."
            android:textSize="16sp"
            android:background="#F0F0F0"
            android:padding="16dp"
            android:minHeight="100dp" />

    </LinearLayout>
</ScrollView>